{
  "name": "ogblacman",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite-ssg build && node scripts/finalize-build.mjs",
    "deploy:surge": "VITE_SITE_URL=https://ogblacman.surge.sh npm run build && surge dist ogblacman.surge.sh",
    "playlist:sync": "node scripts/sync-playlist.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/vue": "^1.27.0",
    "@unhead/vue": "^2.1.2",
    "pinia": "^4.0.3",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.0.1",
    "surge": "^0.43.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
